# ---------------------------------------------------------------------------
# ArenaHub configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit your real `.env` file (it is git-ignored).
# ---------------------------------------------------------------------------

# Your official Arena API key.
# Get it from your Arena account settings at https://arena.ai (API/developer
# section). This key is sent to the official Arena API only — it is never
# printed, logged, or returned to clients.
ARENA_API_KEY=

# Base URL of the official Arena API.
ARENA_BASE_URL=https://api.preview.arena.ai

# Optional default model id (or ArenaHub alias) used when a client does not
# specify one. Run `arenahub models` to see available ids/aliases.
ARENA_DEFAULT_MODEL=

# Per-request timeout (seconds) for calls to the Arena API.
ARENA_TIMEOUT=120

# ---------------------------------------------------------------------------
# Model router
# ---------------------------------------------------------------------------

# How long (seconds) the model list is cached before re-fetching from Arena.
ARENA_MODEL_CACHE_TTL=300

# Extra model aliases in the form  alias=model-id,alias2=model-id2
# Built-in aliases (arena/claude, arena/claude-sonnet, arena/claude-opus,
# arena/gpt, arena/gemini) are always available.
ARENA_MODEL_ALIASES=

# ---------------------------------------------------------------------------
# ArenaHub gateway / platform server
# ---------------------------------------------------------------------------

# Bind address. 127.0.0.1 keeps the server local; set 0.0.0.0 only behind a
# secured reverse proxy in production (see README "Deployment").
ARENAHUB_HOST=127.0.0.1
ARENAHUB_PORT=8000

# Local API key that ALL clients must present to use ArenaHub
# (Authorization: Bearer <key>, X-API-Key, or X-Api-Key).
# If unset, a random ephemeral key is generated on every start and printed in
# the server console. Generate a stable one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ARENAHUB_API_KEY=

# Maximum accepted JSON request body size in bytes (uploads capped separately).
ARENAHUB_MAX_REQUEST_BYTES=2097152

# In-memory per-IP rate limit (requests per minute). Set 0 to disable.
ARENAHUB_RATE_LIMIT_PER_MINUTE=120

# Additional allowed CORS origins (comma-separated). Default: loopback only.
# Example: ARENAHUB_ALLOW_ORIGINS=https://app.example.com
ARENAHUB_ALLOW_ORIGINS=

# Serve FastAPI docs at /docs (disabled by default).
ARENAHUB_ENABLE_DOCS=false

# Storage locations (defaults under ~/.arenahub).
ARENAHUB_HISTORY_DIR=
ARENAHUB_DB_PATH=
ARENAHUB_UPLOAD_DIR=
